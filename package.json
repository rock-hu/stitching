  "engines": {
    "node": ">= 22.11.0"
  },
  "rnx-kit": {
    "kitType": "app",
    "alignDeps": {
      "requirements": [
        "react-native@0.86.0"
      ],
      "capabilities": [
        "core-android",
        "core-ios",
        "core-macos",
        "core-visionos",
